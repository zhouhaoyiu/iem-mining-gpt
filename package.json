{
  "name": "zhy-page",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/element-plus/element-plus-vite-starter"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"node --env-file-if-exists=.env --watch ./server/index.js\"",
    "dev:client": "vite",
    "start": "node --env-file-if-exists=.env ./server/index.js",
    "build": "vite build",
    "generate": "vite build",
    "lint": "oxlint --deny typescript/no-explicit-any .",
    "preview": "vite build && vite preview --host",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.*"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fontsource/lato": "5.3.0",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.0",
    "@lucide/vue": "^1.58.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dompurify": "^3.4.17",
    "element-plus": "2.14.7",
    "express": "^5.3.0",
    "glob": "^13.0.6",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "koa-static": "^5.0.0",
    "marked": "^18.1.1",
    "openai": "^7.32.0",
    "pinia": "^4.0.3",
    "vite-plugin-inspect": "^12.1.0",
    "vue": "^3.5.44",
    "vue-pdf-embed": "^2.1.7",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/ep": "^1.2.4",
    "@iconify-json/ri": "^1.2.10",
    "@types/koa": "^3.0.3",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^30.1.3",
    "oxlint": "1.83.0",
    "sass-embedded": "1.105.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unocss": "^66.11.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.3.4",
    "vite-ssg": "^28.3.0",
    "vue-tsc": "^3.3.13"
  }
